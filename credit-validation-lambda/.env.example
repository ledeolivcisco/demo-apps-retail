# Splunk Observability Cloud — used to instrument the Lambda function with
# the Splunk OpenTelemetry Lambda layer. Copy this file to .env and fill in
# real values (`.env` is gitignored, never commit real tokens).

SPLUNK_REALM=us1
SPLUNK_ACCESS_TOKEN=changeme

# Service identity as it will appear in APM
OTEL_SERVICE_NAME=credit-validation-lambda
DEPLOYMENT_ENV=ledeoliv-credit-validation-lambda
