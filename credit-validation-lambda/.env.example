# Splunk Observability Cloud — used to instrument the Lambda function with
# the Splunk OpenTelemetry Lambda layer. Copy this file to .env and fill in
# real values (`.env` is gitignored, never commit real tokens).

SPLUNK_REALM=us1
SPLUNK_ACCESS_TOKEN=changeme

# Service identity as it will appear in APM — one variable per deploy script.
# DEPLOYMENT_ENV must match DEPLOYMENT_ENV in the compose .env of the stack that
# calls this function — Splunk APM scopes the service map per environment, so a
# different value makes the lambda render as a separate, disconnected system.
#
# Each deploy script reads its own variable and falls back to the function name
# if unset (do not use a shared OTEL_SERVICE_NAME — both scripts source this file).
CREDIT_VALIDATION_OTEL_SERVICE_NAME=credit-validation-lambda
APPLIANCE_PRICING_OTEL_SERVICE_NAME=appliance-pricing-lambda
DEPLOYMENT_ENV=dev

# Credit approval rate for the lambda (0.0–1.0). Use 1.0 for deterministic E2E / synthetic runs.
# APPROVAL_RATE=1.0
